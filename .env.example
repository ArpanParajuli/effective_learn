# =============================================================================
# EffectiveLearn Environment Configuration Template
# DO NOT commit the actual `.env` file containing sensitive credentials to Git.
# Copy this file to `.env` and fill in your secure local / deployment values.
# =============================================================================

# Database (PostgreSQL 17)
POSTGRES_DB=effectivelearn
POSTGRES_USER=effective_app
POSTGRES_PASSWORD=replace_with_a_strong_password_minimum_16_chars
POSTGRES_PORT=5432

# Backend Connection & Runtime (.NET 10 LTS)
ASPNETCORE_ENVIRONMENT=Development
DATABASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=effectivelearn;Username=effective_app;Password=replace_with_a_strong_password_minimum_16_chars

# Authentication / Security
JWT_SECRET=super_secret_signing_key_must_be_at_least_32_characters_long_for_hs256
JWT_ISSUER=EffectiveLearnApi
JWT_AUDIENCE=EffectiveLearnWeb
JWT_EXPIRATION_MINUTES=60
REFRESH_TOKEN_EXPIRATION_DAYS=7

# CORS / Origin Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Frontend Environment Variables (Vite requires VITE_ prefix)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_NAME="EffectiveLearn"
VITE_APP_ENV=development
